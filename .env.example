# Puertos expuestos en el host
FRONTEND_PORT=4200
BACKEND_PORT=8000
MYSQL_PORT=3306
REDIS_PORT=6379

# Credenciales de MySQL (Laravel las recibe como variables de entorno)
MYSQL_DATABASE=logistica
MYSQL_USER=logistica
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root

# API de tarifas de la transportadora.
# Por defecto se usa el simulador local (servicio transportadora-mock).
# Para la API real: TRANSPORTADORA_URL=https://tarifas.transportadora.test/v1 y el token entregado.
TRANSPORTADORA_URL=http://transportadora-mock/v1
TRANSPORTADORA_TOKEN=token-local
